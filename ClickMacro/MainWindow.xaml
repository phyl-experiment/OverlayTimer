<Window x:Class="ClickMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickMacro" Height="160" Width="230"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid Margin="16 14 16 14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Text="중지됨"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#444"
                   TextAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="3번 지속" VerticalAlignment="Center" FontSize="12" Foreground="#555"/>
            <TextBox x:Name="IntervalBox"
                     Width="42" Margin="8 0 4 0"
                     TextAlignment="Center" FontSize="12"
                     VerticalContentAlignment="Center" Padding="0 3"/>
            <TextBlock Text="초" VerticalAlignment="Center" FontSize="12" Foreground="#555"/>
        </StackPanel>

        <Button x:Name="ToggleButton"
                Grid.Row="3"
                Content="시작  (F12)"
                FontSize="12"
                Click="ToggleButton_Click"/>
    </Grid>
</Window>
