<Window x:Class="OverlayTimer.OverlayTimerWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       WindowStyle="None"
       ResizeMode="CanResize"
       SizeToContent="WidthAndHeight"
       MinWidth="180"
       MinHeight="180"
       MaxWidth="520"
       MaxHeight="520"
       AllowsTransparency="True"
       Background="Transparent"
       Topmost="True"
       WindowStartupLocation="Manual"
       Left="500"
       Top="60"
       ShowInTaskbar="True"
       Loaded="Window_Loaded">

    <!-- 클릭은 통과시키고, UI는 표시만 -->
    <Grid x:Name="Root" IsHitTestVisible="False" Background="#01000000">

        <Border Padding="18" Background="Transparent">

            <Grid x:Name="RingCanvas"
                  Width="220"
                  Height="220"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <!-- 딤드 배경 원 (시각 전용, 히트테스트 무관) -->
                <Ellipse Fill="#77000000" IsHitTestVisible="False"/>

                <!-- 배경 링 -->
                <Ellipse x:Name="BackgroundRing" Stroke="#44FFFFFF" StrokeThickness="14"/>

                <!-- 진행 링(Arc) -->
                <Path x:Name="ProgressArc"
                      Stroke="#B4B4B4"
                      StrokeThickness="14"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                <!-- 링 내부 텍스트 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock x:Name="PhaseLabelText"
                               Text="READY"
                               Foreground="#B4B4B4"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,1"/>

                    <TextBlock x:Name="TimeText"
                               Text="0.0s"
                               Foreground="#B4B4B4"
                               FontSize="48"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="DetailText"
                               Text=""
                               Foreground="#B4B4B4"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>
